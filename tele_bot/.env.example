# Telegram Bot
BOT_TOKEN=your_bot_token_from_botfather

# PostgreSQL (Neon)
DATABASE_URL=postgresql://neondb_owner:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require

# Role assignment by Telegram user ID (comma-separated)
# Get your ID from @userinfobot on Telegram
ADMIN_TELEGRAM_IDS=123456789
PURCHASER_TELEGRAM_IDS=
VIEWER_TELEGRAM_IDS=

# Bot update delivery: polling (local testing) or webhook (production)
BOT_MODE=polling

# Webhook (required when BOT_MODE=webhook)
WEBHOOK_URL=https://your-app.vercel.app
WEBHOOK_SECRET=random_secret_string

# Optional
COMPANY_NAME=Lamed Construction PLC
ADMIN_API_KEY=

# Google Sheets (optional — records completed purchases automatically)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Sheet1
